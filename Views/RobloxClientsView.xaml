<UserControl x:Class="LeitostrapV7.Views.RobloxClientsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="#000000">
    <UserControl.Resources>
        <Style x:Key="CardBtn" TargetType="Button" BasedOn="{StaticResource ModernBtn}"/>
        <Style x:Key="GreenBtn" TargetType="Button" BasedOn="{StaticResource ModernGreenBtn}"/>
    </UserControl.Resources>


    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>


            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="Desktop20" FontSize="18" Foreground="#22C55E" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="Roblox Clients" FontSize="18" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                <Border x:Name="CountBadge" Background="#1A1A1A" CornerRadius="10"
                        Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="CountText" Text="0" FontSize="10" Foreground="#555555"/>
                </Border>
            </StackPanel>


            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="RefreshBtn" Style="{StaticResource CardBtn}"
                        Click="RefreshBtn_Click" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon x:Name="RefreshIcon" Symbol="ArrowSync20" FontSize="11" Margin="0,0,5,0"/>
                        <TextBlock Text="Refresh" FontSize="10"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>


        <Border Grid.Row="2" Background="#050505" BorderBrush="#1A1A1A" BorderThickness="1"
                CornerRadius="10" Padding="12">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ClientsListPanel"/>
                </ScrollViewer>


                <StackPanel x:Name="EmptyStatePanel"
                            VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ui:SymbolIcon Symbol="Search20" FontSize="32" Foreground="#333333"
                               HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="No Roblox clients detected" FontSize="11" Foreground="#555555"
                               HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock Text="Start Roblox to see clients here" FontSize="11" Foreground="#555555"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
