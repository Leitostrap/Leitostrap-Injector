<UserControl x:Class="LeitostrapV7.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="#000000">
    <UserControl.Resources>
        <SolidColorBrush x:Key="Bg" Color="#000000"/>
        <SolidColorBrush x:Key="Bg2" Color="#050505"/>
        <SolidColorBrush x:Key="CardBg" Color="#0A0A0A"/>
        <SolidColorBrush x:Key="Bdr" Color="#1A1A1A"/>
        <SolidColorBrush x:Key="T1" Color="White"/>
        <SolidColorBrush x:Key="T2" Color="#555555"/>
        <SolidColorBrush x:Key="T3" Color="#333333"/>
        <SolidColorBrush x:Key="Red" Color="#EF4444"/>


        <Style x:Key="CardBtn" TargetType="Button" BasedOn="{StaticResource ModernBtn}"/>
    </UserControl.Resources>


    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <TextBlock Grid.Row="0" Text="Settings" FontSize="18" FontWeight="SemiBold" Foreground="White"/>


        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="#0A0A0A" BorderBrush="#1A1A1A" BorderThickness="1" 
                        CornerRadius="10" Padding="18,14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Injection Method" FontSize="12" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,12"/>


                        <Border x:Name="MethodDropdown" Background="#050505" BorderBrush="#1A1A1A" BorderThickness="1" 
                                CornerRadius="8" Padding="12,10" Cursor="Hand" MouseLeftButtonDown="MethodDropdown_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>


<Border Grid.Column="0" Background="#1A1A1A" CornerRadius="4" 
                                        Width="24" Height="24" Margin="0,0,10,0">
                                    <ui:SymbolIcon x:Name="MethodIcon" Symbol="Layer20" FontSize="14"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                                </Border>


                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="MethodLabel" Text="Memory Offsets" FontSize="11" Foreground="White"/>
                                    <TextBlock x:Name="MethodDesc" Text="Recommended - uses offset database for direct memory writes" 
                                               FontSize="9" Foreground="#555555"/>
                                </StackPanel>


                                <ui:SymbolIcon Grid.Column="2" Symbol="ChevronDown20" FontSize="8" Foreground="#555555" 
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>


                        <Border x:Name="MethodOptionsPanel" Background="#050505" BorderBrush="#1A1A1A" BorderThickness="1" 
                                CornerRadius="8" Margin="0,4,0,0" Visibility="Collapsed">
                            <StackPanel Margin="4">
                                <Border x:Name="OptMemory" Background="#0A0A0A" CornerRadius="6" 
                                        Padding="10,8" Margin="0,2" Cursor="Hand" MouseLeftButtonDown="Option_Click"
                                        Tag="memory">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#1A1A1A" CornerRadius="3" 
                                                Width="18" Height="18" Margin="0,0,8,0">
                                            <ui:SymbolIcon Symbol="Lightbulb20" FontSize="12" Foreground="#888"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Memory Offsets" FontSize="11" Foreground="White"/>
                                            <TextBlock Text="Recommended - uses offset database for direct memory writes" FontSize="9" Foreground="#555555"/>
                                        </StackPanel>
                                        <ui:SymbolIcon x:Name="CheckMemory" Grid.Column="2" Symbol="Checkmark20" FontSize="12" Foreground="White" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    </Grid>
                                </Border>


                                <Border x:Name="OptCache" Background="#0A0A0A" CornerRadius="6" 
                                        Padding="10,8" Margin="0,2" Cursor="Hand" MouseLeftButtonDown="Option_Click"
                                        Tag="cache">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#1A1A1A" CornerRadius="3" 
                                                Width="18" Height="18" Margin="0,0,8,0">
                                            <ui:SymbolIcon Symbol="Document20" FontSize="12" Foreground="#888"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Cache Method" FontSize="11" Foreground="White"/>
                                            <TextBlock Text="Proxy only - modifies Roblox client settings" FontSize="9" Foreground="#555555"/>
                                        </StackPanel>
                                        <ui:SymbolIcon x:Name="CheckCache" Grid.Column="2" Symbol="Checkmark20" FontSize="12" Foreground="White" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    </Grid>
                                </Border>


                                <Border x:Name="OptCombined" Background="#0A0A0A" CornerRadius="6" 
                                        Padding="10,8" Margin="0,2" Cursor="Hand" MouseLeftButtonDown="Option_Click"
                                        Tag="combined">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#1A1A1A" CornerRadius="3" 
                                                Width="18" Height="18" Margin="0,0,8,0">
                                            <ui:SymbolIcon Symbol="Checkmark20" FontSize="12" Foreground="#888"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Combined" FontSize="11" Foreground="White"/>
                                            <TextBlock Text="Combines cache and memory methods" FontSize="9" Foreground="#555555"/>
                                        </StackPanel>
                                        <ui:SymbolIcon x:Name="CheckCombined" Grid.Column="2" Symbol="Checkmark20" FontSize="12" Foreground="White" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    </Grid>
                                </Border>


                                <Border x:Name="OptOffsetless" Background="#0A0A0A" CornerRadius="6" 
                                        Padding="10,8" Margin="0,2" Cursor="Hand" MouseLeftButtonDown="Option_Click"
                                        Tag="offsetless">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#1A1A1A" CornerRadius="3" 
                                                Width="18" Height="18" Margin="0,0,8,0">
                                            <ui:SymbolIcon Symbol="Search20" FontSize="12" Foreground="#888"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Memory Offsetless Pattern Scan" FontSize="11" Foreground="White"/>
                                            <TextBlock Text="Scans memory patterns - no offset database needed" FontSize="9" Foreground="#555555"/>
                                        </StackPanel>
                                        <ui:SymbolIcon x:Name="CheckOffsetless" Grid.Column="2" Symbol="Checkmark20" FontSize="12" Foreground="White" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>


                <TextBlock Text="Discord Rich Presence" FontSize="9" FontWeight="Bold" Foreground="#333333" 
                           Margin="0,0,0,8"/>
                <Border x:Name="RpcSectionContent" Background="#0A0A0A" BorderBrush="#1A1A1A" BorderThickness="1" 
                        CornerRadius="10" Padding="18,14" Margin="0,0,0,12">
                    <Border x:Name="RpcCard" Background="#050505" BorderBrush="#1A1A1A" BorderThickness="1" 
                            CornerRadius="8" Padding="14,10" Cursor="Hand" MouseLeftButtonDown="ToggleSetting_Click"
                            Tag="rpc_enabled">
                        <Grid>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Enable Discord RPC" FontSize="11" Foreground="White"/>
                                <TextBlock Text="Show your activity in Discord" FontSize="9" Foreground="#555555"/>
                            </StackPanel>
                            <Border x:Name="ToggleRpc" Grid.Column="1" Width="40" Height="22" CornerRadius="11" 
                                    Background="#2A2A2A" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Border x:Name="KnobRpc" Width="16" Height="16" CornerRadius="8" 
                                        Background="White" HorizontalAlignment="Left" Margin="3,0"/>
                            </Border>
                        </Grid>
                    </Border>
                </Border>


                <TextBlock Text="Overlay / Visibility" FontSize="9" FontWeight="Bold" Foreground="#333333" 
                           Margin="0,0,0,8"/>
                <Border x:Name="OverlaySectionContent" Background="#0A0A0A" BorderBrush="#1A1A1A" BorderThickness="1" 
                        CornerRadius="10" Padding="18,14" Margin="0,0,0,12">
                    <Border Background="#050505" BorderBrush="#1A1A1A" BorderThickness="1" 
                            CornerRadius="8" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>


                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Toggle UI Hotkey" FontSize="11" Foreground="White" Margin="0,0,0,6"/>
                                <Border Background="#1A1A1A" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left">
                                    <TextBlock x:Name="HotkeyDisplay" Text="Insert" FontSize="10" Foreground="White" 
                                               FontFamily="Cascadia Mono, Consolas"/>
                                </Border>
                            </StackPanel>


                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Style="{StaticResource CardBtn}" Margin="0,0,6,0" 
                                        Click="ChangeHotkey_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Edit20" FontSize="11" Margin="0,0,5,0"/>
                                        <TextBlock Text="Change" FontSize="10"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource CardBtn}" Click="TestHotkey_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Play20" FontSize="11" Margin="0,0,5,0"/>
                                        <TextBlock Text="Test" FontSize="10"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Border>


                <TextBlock Text="Tips &amp; Notifications" FontSize="9" FontWeight="Bold" Foreground="#333333" 
                           Margin="0,0,0,8"/>
                <Border x:Name="TipsSectionContent" Background="#0A0A0A" BorderBrush="#1A1A1A" BorderThickness="1" 
                        CornerRadius="10" Padding="18,14" Margin="0,0,0,12">
                    <StackPanel>
                        <Border x:Name="TipsCard" Background="#050505" BorderBrush="#1A1A1A" BorderThickness="1" 
                                CornerRadius="8" Padding="14,10" Margin="0,0,0,6" Cursor="Hand" MouseLeftButtonDown="ToggleSetting_Click"
                                Tag="tips_enabled">
                            <Grid>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Show Top Tips" FontSize="11" Foreground="White"/>
                                    <TextBlock Text="Display helpful tips at the top of the UI" FontSize="9" Foreground="#555555"/>
                                </StackPanel>
                                <Border x:Name="ToggleTips" Grid.Column="1" Width="40" Height="22" CornerRadius="11" 
                                        Background="#2A2A2A" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Border x:Name="KnobTips" Width="16" Height="16" CornerRadius="8" 
                                            Background="White" HorizontalAlignment="Left" Margin="3,0"/>
                                </Border>
                            </Grid>
                        </Border>


                        <Border x:Name="NotifSoundCard" Background="#050505" BorderBrush="#1A1A1A" BorderThickness="1" 
                                CornerRadius="8" Padding="14,10" Margin="0,0,0,6" Cursor="Hand" MouseLeftButtonDown="ToggleSetting_Click"
                                Tag="notif_sound">
                            <Grid>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Notification Sound" FontSize="11" Foreground="White"/>
                                    <TextBlock Text="Play a sound on notifications" FontSize="9" Foreground="#555555"/>
                                </StackPanel>
                                <Border x:Name="ToggleNotifSound" Grid.Column="1" Width="40" Height="22" CornerRadius="11" 
                                        Background="#2A2A2A" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Border x:Name="KnobNotifSound" Width="16" Height="16" CornerRadius="8" 
                                            Background="White" HorizontalAlignment="Left" Margin="3,0"/>
                                </Border>
                            </Grid>
                        </Border>


                        <Border x:Name="UiSoundsCard" Background="#050505" BorderBrush="#1A1A1A" BorderThickness="1" 
                                CornerRadius="8" Padding="14,10" Cursor="Hand" MouseLeftButtonDown="ToggleSetting_Click"
                                Tag="ui_sounds">
                            <Grid>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="UI Sounds" FontSize="11" Foreground="White"/>
                                    <TextBlock Text="Play sounds for UI interactions" FontSize="9" Foreground="#555555"/>
                                </StackPanel>
                                <Border x:Name="ToggleUiSounds" Grid.Column="1" Width="40" Height="22" CornerRadius="11" 
                                        Background="#2A2A2A" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Border x:Name="KnobUiSounds" Width="16" Height="16" CornerRadius="8" 
                                            Background="White" HorizontalAlignment="Left" Margin="3,0"/>
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>


                <TextBlock Text="Potato Mode" FontSize="9" FontWeight="Bold" Foreground="#333333" 
                           Margin="0,0,0,8"/>
                <Border x:Name="PotatoSectionContent" Background="#0A0A0A" BorderBrush="#1A1A1A" BorderThickness="1" 
                        CornerRadius="10" Padding="18,14" Margin="0,0,0,20">
                    <Border x:Name="PotatoCard" Background="#050505" BorderBrush="#1A1A1A" BorderThickness="1" 
                            CornerRadius="8" Padding="14,10" Cursor="Hand" MouseLeftButtonDown="ToggleSetting_Click"
                            Tag="potato_mode">
                        <Grid>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Potato Mode" FontSize="11" Foreground="White"/>
                                <TextBlock Text="Disables animations for better performance" FontSize="9" Foreground="#555555"/>
                            </StackPanel>
                            <Border x:Name="TogglePotato" Grid.Column="1" Width="40" Height="22" CornerRadius="11" 
                                    Background="#2A2A2A" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Border x:Name="KnobPotato" Width="16" Height="16" CornerRadius="8" 
                                        Background="White" HorizontalAlignment="Left" Margin="3,0"/>
                            </Border>
                        </Grid>
                    </Border>
                </Border>


                <TextBlock Text="HWID Spoofer" FontSize="9" FontWeight="Bold" Foreground="#333333" 
                           Margin="0,0,0,8"/>
                <Border Background="#0A0A0A" BorderBrush="#1A1A1A" BorderThickness="1" 
                        CornerRadius="10" Padding="18,14" Margin="0,0,0,12">
                    <StackPanel>
                        <Border Background="#050505" BorderBrush="#1A1A1A" BorderThickness="1" 
                                CornerRadius="8" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="Hardware ID Spoofer" FontSize="11" Foreground="White" Margin="0,0,0,4"/>
                                <TextBlock Text="Changes your Machine GUID in registry to avoid HWID bans" FontSize="9" Foreground="#555555" Margin="0,0,0,12"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource CardBtn}" Click="SpoofBtn_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Shield20" FontSize="11" Margin="0,0,5,0"/>
                                            <TextBlock Text="Spoof HWID" FontSize="10"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource CardBtn}" Margin="8,0,0,0" Click="RestoreBtn_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="ArrowReply20" FontSize="11" Margin="0,0,5,0"/>
                                            <TextBlock Text="Restore HWID" FontSize="10" Foreground="#EF4444"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock x:Name="HwidStatusText" Text="" FontSize="9" Foreground="#555555" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
