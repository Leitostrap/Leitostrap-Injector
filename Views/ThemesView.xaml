<UserControl x:Class="LeitostrapV7.Views.ThemesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{StaticResource Bg}" Loaded="OnLoaded">
    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="Color20" FontSize="18" Foreground="#FFFFFF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="Themes" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" VerticalAlignment="Center"/>
                <Border Background="{StaticResource BgCard}" CornerRadius="10" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="ThemeCountText" Text="" FontSize="10" Foreground="{StaticResource TextDim}"/>
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="ClearBgBtn" Style="{StaticResource ModernBtn}" Foreground="#EF4444" Click="ClearBgBtn_Click" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Dismiss20" FontSize="11" Margin="0,0,5,0"/>
                        <TextBlock Text="Clear" FontSize="10"/>
                    </StackPanel>
                </Button>
                <Button x:Name="UploadBtn" Style="{StaticResource ModernBtn}" Click="UploadBtn_Click">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="DocumentArrowDown20" FontSize="11" Margin="0,0,5,0"/>
                        <TextBlock Text="Upload Image" FontSize="10"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>


        <Border Grid.Row="2" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="6" Padding="10,5">
            <Grid>
                <ui:SymbolIcon Symbol="Search20" FontSize="11" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" IsHitTestVisible="False"/>
                <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextMain}" FontSize="11" VerticalContentAlignment="Center" CaretBrush="{StaticResource TextMain}" Margin="20,0,0,0" TextChanged="SearchBox_TextChanged"/>
            </Grid>
        </Border>


        <StackPanel Grid.Row="4" Orientation="Horizontal">
            <ui:SymbolIcon Symbol="PaintBrush20" FontSize="12" Foreground="{StaticResource TextDim}" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="Static Themes" FontSize="14" Foreground="{StaticResource TextMain}" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>


        <Border Grid.Row="6" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
            <ScrollViewer x:Name="StaticScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="StaticList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ContentPresenter Content="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>


        <StackPanel Grid.Row="8" Orientation="Horizontal">
            <ui:SymbolIcon Symbol="ArrowSync20" FontSize="12" Foreground="{StaticResource TextDim}" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="Animated Themes" FontSize="14" Foreground="{StaticResource TextMain}" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>


        <Border Grid.Row="10" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
            <ScrollViewer x:Name="AnimatedScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="AnimatedList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ContentPresenter Content="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>


        <Border Grid.Row="12" x:Name="ActiveThemeBar" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="6" Padding="12,8" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Checkmark20" FontSize="11" Foreground="{StaticResource Accent}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="Active: " FontSize="10" Foreground="{StaticResource TextDim}" VerticalAlignment="Center"/>
                <TextBlock x:Name="ActiveThemeName" Text="" FontSize="10" Foreground="{StaticResource Accent}" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
