<UserControl x:Class="LeitostrapV7.Views.FFlagsEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:Core="clr-namespace:LeitostrapV7.Core"
             Background="#000000">
    <UserControl.Resources>
        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bg" Background="#0A0A0A" BorderBrush="#2A2A2A" BorderThickness="1"
                                    CornerRadius="5" Padding="{TemplateBinding Padding}"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </Border.RenderTransform>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Bg" Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)" To="1.04" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="Bg" Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)" To="1.04" Duration="0:0:0.12"/>
                                            <ColorAnimation Storyboard.TargetName="Bg" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#161616" Duration="0:0:0.12"/>
                                            <ColorAnimation Storyboard.TargetName="Bg" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#444444" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Bg" Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="Bg" Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2"/>
                                            <ColorAnimation Storyboard.TargetName="Bg" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#0A0A0A" Duration="0:0:0.2"/>
                                            <ColorAnimation Storyboard.TargetName="Bg" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#2A2A2A" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Bg" Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)" To="0.96" Duration="0:0:0.06"/>
                                            <DoubleAnimation Storyboard.TargetName="Bg" Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)" To="0.96" Duration="0:0:0.06"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Bg" Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="Bg" Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="ExplorerItem" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>


    </UserControl.Resources>


    <Grid x:Name="MainGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <Border x:Name="ExplorerBorder" Grid.Column="0" Background="#050505" BorderBrush="#1A1A1A" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <Border Grid.Row="0" Padding="12,0" VerticalAlignment="Center" MouseLeftButtonDown="ExplorerPanel_Click" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon x:Name="ExplorerToggleIcon" Symbol="ChevronLeft20" FontSize="10" Foreground="#555555" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Explorer" FontSize="11" FontWeight="SemiBold" Foreground="#888888" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>


                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="6,4">
                    <StackPanel>
                        <Border Background="#0A0A0A" CornerRadius="4" Padding="8,5" Margin="0,0,0,6" BorderBrush="#1A1A1A" BorderThickness="1">
                            <Grid>
                                <ui:SymbolIcon Symbol="Search20" FontSize="10" Foreground="#444444" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="10"
                                         VerticalContentAlignment="Center" CaretBrush="White" Padding="0" Margin="16,0,0,0"/>
                            </Grid>
                        </Border>


                        <Border Style="{StaticResource ExplorerItem}" MouseLeftButtonDown="FFlagsSection_Click">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon x:Name="FFlagsToggleIcon" Symbol="ChevronDown20" FontSize="9" Foreground="#555555" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <ui:SymbolIcon Symbol="Flag20" FontSize="12" Foreground="#888888" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="FFlags" FontSize="11" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <StackPanel x:Name="FFlagsFileTree" Margin="12,0,0,0">
                            <Border Background="#0A0A0A" CornerRadius="4" Padding="8,6" Margin="0,1" Cursor="Hand">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Folder20" FontSize="11" Foreground="#666666" Margin="0,0,6,0"/>
                                        <TextBlock Text="Default" FontSize="10" Foreground="#AAAAAA"/>
                                    </StackPanel>
                                    <TextBlock x:Name="DefaultFlagCount" Text="   0 flags" FontSize="9" Foreground="#444444" Margin="17,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>


                        <Border Style="{StaticResource ExplorerItem}" Margin="0,4,0,0" MouseLeftButtonDown="SavedSection_Click">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon x:Name="SavedToggleIcon" Symbol="ChevronRight20" FontSize="9" Foreground="#555555" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <ui:SymbolIcon Symbol="Star20" FontSize="12" Foreground="#888888" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Saved FFlags" FontSize="11" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <StackPanel x:Name="SavedFileTree" Visibility="Collapsed" Margin="12,0,0,0">
                            <TextBlock x:Name="SavedEmptyText" Text="   Nothing saved yet" FontSize="9" Foreground="#444444" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>


        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="28"/>
            </Grid.RowDefinitions>


            <Border Grid.Row="0" Background="#050505" BorderBrush="#1A1A1A" BorderThickness="0,0,0,1" Padding="10,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Roblox: " FontSize="9" Foreground="#444444"/>
                    <TextBlock x:Name="RobloxStatusText" Text="Checking..." FontSize="9" Foreground="#555555" Margin="0,0,14,0"/>
                    <TextBlock Text="PID: " FontSize="9" Foreground="#444444"/>
                    <TextBlock x:Name="PidText" Text="-" FontSize="9" Foreground="#555555" Margin="0,0,14,0"/>
                    <TextBlock Text="Flags: " FontSize="9" Foreground="#444444"/>
                    <TextBlock x:Name="FFlagsLoadedText" Text="0" FontSize="9" Foreground="#555555" Margin="0,0,14,0"/>
                    <TextBlock Text="Cache: " FontSize="9" Foreground="#444444"/>
                    <TextBlock x:Name="CacheOffsetsText" Text="0" FontSize="9" Foreground="#555555" Margin="0,0,14,0"/>
                    <TextBlock Text="Memory: " FontSize="9" Foreground="#444444"/>
                    <TextBlock x:Name="MemoryOffsetsText" Text="0" FontSize="9" Foreground="#555555"/>
                </StackPanel>
            </Border>


            <Border x:Name="TabBarBorder" Grid.Row="1" Background="#0A0A0A" BorderBrush="#1A1A1A" BorderThickness="0,0,0,1" Padding="6,4">
                <StackPanel Orientation="Horizontal">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden">
                        <StackPanel x:Name="TabBarPanel" Orientation="Horizontal">
                            <Border Background="#050505" BorderBrush="#1A1A1A" BorderThickness="1,1,1,0" CornerRadius="6,6,0,0"
                                    Padding="12,5" Margin="2,0" Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Document20" FontSize="10" Foreground="#888888" Margin="0,0,6,0"/>
                                    <TextBlock Text="Welcome" FontSize="10" Foreground="White"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <Button x:Name="AddTabBtn" Content="+" FontSize="13" Foreground="#555555"
                            Style="{StaticResource ModernBtn}" Width="24" Height="24"
                            Padding="0" Margin="4,0" Click="AddTabBtn_Click"/>
                </StackPanel>
            </Border>


            <Border Grid.Row="2" Background="#050505" BorderBrush="#1A1A1A" BorderThickness="0,0,0,1" Padding="6,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolBtn}" Click="ApplyBtn_Click" Padding="10,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="CheckmarkCircle20" FontSize="13" Margin="0,0,6,0"/>
                            <TextBlock Text="Apply FFlags" FontSize="10.5" FontWeight="SemiBold" Foreground="White"/>
                        </StackPanel>
                    </Button>


                    <Button Style="{StaticResource ToolBtn}" Click="ClearFlags_Click" Padding="10,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Delete20" FontSize="11" Margin="0,0,5,0"/>
                            <TextBlock Text="Clear" FontSize="10.5"/>
                        </StackPanel>
                    </Button>


                    <Border Width="1" Height="16" Background="#1E1E1E" Margin="6,0" VerticalAlignment="Center"/>


                    <Button Style="{StaticResource ToolBtn}" Click="ImportBtn_Click" Padding="10,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="FolderOpen20" FontSize="12" Margin="0,0,5,0"/>
                            <TextBlock Text="Import" FontSize="10.5"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolBtn}" Click="SaveAsBtn_Click" Padding="10,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Save20" FontSize="11" Margin="0,0,5,0"/>
                            <TextBlock Text="Save" FontSize="10.5"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolBtn}" Click="ExportBtn_Click" Padding="10,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowDownload20" FontSize="12" Margin="0,0,5,0"/>
                            <TextBlock Text="Export" FontSize="10.5"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolBtn}" Click="CopyFlags_Click" Padding="10,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Copy20" FontSize="11" Margin="0,0,5,0"/>
                            <TextBlock Text="Copy" FontSize="10.5"/>
                        </StackPanel>
                    </Button>


                    <Border Width="1" Height="16" Background="#1E1E1E" Margin="6,0" VerticalAlignment="Center"/>


                    <Button Style="{StaticResource ToolBtn}" Click="OpenClients_Click" Padding="10,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Desktop20" FontSize="11" Margin="0,0,5,0"/>
                            <TextBlock Text="Clients" FontSize="10.5"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                    <TextBlock Grid.Column="1" x:Name="MethodLabel" Text="Memory Offsets" FontSize="9" Foreground="#444444" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                </Grid>
            </Border>


            <Grid Grid.Row="3" Background="#050505">
                <Grid x:Name="WelcomePage" Margin="30,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>


                    <StackPanel Grid.Column="0" VerticalAlignment="Top">
                        <TextBlock Text="Leitostrap" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,4"/>
                        <TextBlock Text="FastFlags editor" FontSize="11" Foreground="#555555" Margin="0,0,0,24"/>
                        <TextBlock Text="GET STARTED" FontSize="9" FontWeight="Bold" Foreground="#555555" Margin="0,0,0,10"/>
                        <Button Style="{StaticResource ToolBtn}" Click="JoinDiscord_Click" HorizontalAlignment="Left" Padding="10,6">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="People20" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="Join Discord Server" FontSize="10.5"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolBtn}" Click="OpenThemes_Click" HorizontalAlignment="Left" Padding="10,6">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Color20" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="Themes &amp; Appearance" FontSize="10.5"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolBtn}" Click="LaunchRoblox_Click" HorizontalAlignment="Left" Padding="10,6">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Desktop20" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="Launch Roblox" FontSize="10.5"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>


                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                        <TextBlock Text="START" FontSize="9" FontWeight="Bold" Foreground="#555555" Margin="0,0,0,10"/>
                        <Button Style="{StaticResource ToolBtn}" Click="AddTabBtn_Click" HorizontalAlignment="Left" Padding="10,6">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Add20" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="New FFlag Tab" FontSize="10.5"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolBtn}" Click="ImportBtn_Click" HorizontalAlignment="Left" Padding="10,6">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="DocumentArrowDown20" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="Import FFlags" FontSize="10.5"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="RECENT" FontSize="9" FontWeight="Bold" Foreground="#555555" Margin="0,16,0,10"/>
                        <TextBlock Text="No flags imported yet" FontSize="10" Foreground="#333333"/>
                    </StackPanel>
                </Grid>


                <Border x:Name="FlagTableBorder" Visibility="Collapsed" Background="#050505" Padding="8,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#0A0A0A" CornerRadius="4" Padding="8,4" Margin="4,4,4,2" BorderBrush="#1A1A1A" BorderThickness="1">
                            <Grid>
                                <ui:SymbolIcon Symbol="Search20" FontSize="11" Foreground="#444444" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <TextBox x:Name="TableSearchBox" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="11"
                                         VerticalContentAlignment="Center" CaretBrush="White" Padding="0" Margin="20,0,0,0"
                                         TextChanged="TableSearchBox_TextChanged"/>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="1" Margin="4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="35*"/>
                                <ColumnDefinition Width="35*"/>
                                <ColumnDefinition Width="14*"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="SelectAllCheck" Grid.Column="0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Flag" FontSize="9" FontWeight="Bold" Foreground="#444444" VerticalAlignment="Center" Margin="4,0"/>
                            <TextBlock Grid.Column="2" Text="Value" FontSize="9" FontWeight="Bold" Foreground="#444444" VerticalAlignment="Center" Margin="4,0"/>
                            <TextBlock Grid.Column="3" Text="Type" FontSize="9" FontWeight="Bold" Foreground="#444444" VerticalAlignment="Center" Margin="4,0"/>
                            <TextBlock Grid.Column="4" Text="Del" FontSize="9" FontWeight="Bold" Foreground="#444444" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Grid>
                        <DataGrid Grid.Row="2" x:Name="FlagDataGrid" AutoGenerateColumns="False"
                                  Background="Transparent" BorderThickness="0" GridLinesVisibility="None"
                                  HeadersVisibility="None" CanUserAddRows="False" CanUserDeleteRows="False"
                                  SelectionMode="Extended" RowBackground="Transparent"
                                  AlternatingRowBackground="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  Padding="4,0"
                                  VirtualizingStackPanel.IsVirtualizing="True"
                                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                                  VirtualizingPanel.ScrollUnit="Pixel"
                                  ScrollViewer.CanContentScroll="True"
                                  EnableRowVirtualization="True"
                                  EnableColumnVirtualization="False"
                                  RowHeight="28"
                                  MaxHeight="600">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Binding="{Binding IsSelected, Mode=TwoWay}" Width="28">
                                    <DataGridCheckBoxColumn.ElementStyle>
                                        <Style TargetType="CheckBox">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderBrush" Value="#444444"/>
                                        </Style>
                                    </DataGridCheckBoxColumn.ElementStyle>
                                </DataGridCheckBoxColumn>
                                <DataGridTextColumn Binding="{Binding Name}" Width="2*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="FontSize" Value="10"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="4,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding Value}" Width="2*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#888888"/>
                                            <Setter Property="FontSize" Value="10"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="4,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridComboBoxColumn Header="Type" Width="1*"
                                          SelectedItemBinding="{Binding Type, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <DataGridComboBoxColumn.ElementStyle>
                                        <Style TargetType="ComboBox">
                                            <Setter Property="ItemsSource" Value="{x:Static Core:FFlagTypeSource.Types}"/>
                                            <Setter Property="Foreground" Value="#444444"/>
                                            <Setter Property="FontSize" Value="10"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="IsReadOnly" Value="True"/>
                                        </Style>
                                    </DataGridComboBoxColumn.ElementStyle>
                                    <DataGridComboBoxColumn.EditingElementStyle>
                                        <Style TargetType="ComboBox">
                                            <Setter Property="ItemsSource" Value="{x:Static Core:FFlagTypeSource.Types}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="Background" Value="#0A0A0A"/>
                                            <Setter Property="BorderBrush" Value="#262626"/>
                                            <Setter Property="FontSize" Value="10"/>
                                        </Style>
                                    </DataGridComboBoxColumn.EditingElementStyle>
                                </DataGridComboBoxColumn>
                                <DataGridTemplateColumn Width="28">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="x" FontSize="9" Style="{StaticResource MiniRedBtn}"
                                                    Padding="4,2" Tag="{Binding}"
                                                    Click="DeleteFlagBtn_Click" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>


            <Border x:Name="BottomPanel" Grid.Row="4" Height="150" Visibility="Collapsed"
                    Background="#050505" BorderBrush="#1A1A1A" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#070707" BorderBrush="#1A1A1A" BorderThickness="0,0,0,1" Padding="8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="ProblemsTabBtn" Click="BottomTab_Click" Tag="problems" Cursor="Hand"
                                    Background="Transparent" BorderThickness="0" Padding="8,4" Focusable="False">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Warning20" FontSize="10" Foreground="#444444" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Problems" FontSize="9"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="RobloxOutputTabBtn" Click="BottomTab_Click" Tag="roblox" Cursor="Hand"
                                    Background="Transparent" BorderThickness="0" Padding="8,4" Focusable="False">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Desktop20" FontSize="10" Foreground="#444444" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Roblox Output" FontSize="9"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="TerminalTabBtn" Click="BottomTab_Click" Tag="terminal" Cursor="Hand"
                                    Background="Transparent" BorderThickness="0" Padding="8,4" Focusable="False">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="WindowConsole20" FontSize="10" Foreground="#444444" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Terminal" FontSize="9"/>
                                </StackPanel>
                            </Button>
                            <Border Width="1" Height="14" Background="#1E1E1E" Margin="6,0"/>
                            <Button Click="CloseBottomPanel_Click" Cursor="Hand" Background="Transparent" BorderThickness="0"
                                    Padding="6,4" Focusable="False" ToolTip="Close panel">
                                <ui:SymbolIcon Symbol="Dismiss20" FontSize="10" Foreground="#555555"/>
                            </Button>
                        </StackPanel>
                    </Border>
                    <TextBox x:Name="MiniLogBox" Grid.Row="1" IsReadOnly="True"
                             Background="#050505" Foreground="#9E9E9E" BorderThickness="0"
                             FontFamily="Consolas" FontSize="10" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             Padding="8,6" CaretBrush="Transparent"/>
                </Grid>
            </Border>


            <Border Grid.Row="5" Background="#0A0A0A" BorderBrush="#1A1A1A" BorderThickness="0,1,0,0" Padding="8,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Click="UserConsoleBtn_Click" Tag="problems" Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="0" Focusable="False" ToolTip="Open problems / mini console">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Warning20" FontSize="11" Foreground="#555555" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Problems" FontSize="9" Foreground="#444444" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Click="UserConsoleBtn_Click" Tag="roblox" Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="0" Focusable="False" ToolTip="Show Roblox output in mini console">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Desktop20" FontSize="11" Foreground="#555555" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Roblox Output" FontSize="9" Foreground="#444444" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Click="UserConsoleBtn_Click" Tag="terminal" Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="0" Focusable="False" ToolTip="Open system console (all logs incl. watchdog) in mini console">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="WindowConsole20" FontSize="11" Foreground="#555555" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Terminal" FontSize="9" Foreground="#444444" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="3" Click="UserConsoleBtn_Click" Tag="log" Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="0" Focusable="False" ToolTip="Open full console view (all logs)">
                        <TextBlock Text="Open Full Log" FontSize="9" Foreground="#555555" TextDecorations="Underline" VerticalAlignment="Center"/>
                    </Button>
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="InjectStatusDot" Width="6" Height="6" Fill="#333333" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="InjectStatusText" Text="Not Injected" FontSize="9" Foreground="#444444" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>


        <Button x:Name="ExpandExplorerBtn" Panel.ZIndex="10" 
                HorizontalAlignment="Left" VerticalAlignment="Top" 
                Margin="4,4,0,0" Width="24" Height="24" Cursor="Hand"
                Click="ExpandExplorerBtn_Click" Visibility="Collapsed"
                Style="{StaticResource ToolBtn}">
            <ui:SymbolIcon Symbol="ChevronRight20" FontSize="12" Foreground="#888"/>
        </Button>


        <Border x:Name="ApplyOverlay" Visibility="Collapsed" Background="#CC000000"
                Panel.ZIndex="50" Grid.ColumnSpan="2">
            <Border Background="#0C0C0E" BorderBrush="#1A1A1E" BorderThickness="1"
                    CornerRadius="14" Padding="32,28"
                    HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="340" MaxWidth="420"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="ApplyCardScale" ScaleX="0.92" ScaleY="0.92"/>
                        <TranslateTransform x:Name="ApplyCardSlide" Y="20"/>
                    </TransformGroup>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="White" Opacity="0.03"/>
                </Border.Effect>
                <StackPanel>
                    <Grid HorizontalAlignment="Center" Margin="0,0,0,14">
                        <Ellipse x:Name="ApplyStatusRing" Width="52" Height="52" StrokeThickness="2"
                                 Stroke="#FFFFFF" Fill="#0C0C0E"/>
                        <Ellipse x:Name="ApplyStatusDot" Width="52" Height="52" StrokeThickness="2"
                                 Stroke="#333" Fill="#0C0C0E"/>
                        <ui:SymbolIcon x:Name="ApplyStatusIcon" Symbol="Play20" FontSize="22"
                                       Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock x:Name="ApplyTitleText" Text="Preparing..." FontSize="16" FontWeight="SemiBold"
                               Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock x:Name="ApplyStatusText" Text="" FontSize="11.5"
                               Foreground="#666666" HorizontalAlignment="Center" Margin="0,0,0,18" TextWrapping="Wrap"/>
                    <Border x:Name="ApplyProgressTrack" Background="#161618" CornerRadius="4" Height="4" ClipToBounds="True" Margin="0,0,0,14">
                        <Border x:Name="ApplyProgressFill" Width="0" HorizontalAlignment="Left" CornerRadius="4">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FFFFFF" Offset="0"/>
                                    <GradientStop Color="#888888" Offset="0.5"/>
                                    <GradientStop Color="#FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Border>
                    <Grid>
                        <TextBlock x:Name="ApplyCountText" Text="" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#888888" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="ApplyMethodText" Text="" FontSize="10"
                                   Foreground="#444444" HorizontalAlignment="Right"/>
                    </Grid>
                    <Border x:Name="ApplyResultBorder" Visibility="Collapsed" CornerRadius="8"
                            Padding="14,10" Margin="0,14,0,0" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon x:Name="ApplyResultIcon" Symbol="CheckmarkCircle20" FontSize="16"
                                           Foreground="#FFFFFF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ApplyResultText" Text="" FontSize="11"
                                       Foreground="#CCCCCC" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
