<Window
    x:Class="LeitostrapV7.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:LeitostrapV7.Views"
    Title="Leitostrap"
    Width="1050"
    Height="600"
    MinWidth="850"
    MinHeight="480"
    Background="Transparent"
    WindowStyle="None"
    AllowsTransparency="True"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterScreen"
    Icon="/LeitostrapV7;component/Leitostrap.ico"
    Opacity="0">


    <Window.Resources>
        <Style x:Key="NavBtn" TargetType="RadioButton">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="Nav"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid x:Name="Root">
                            <Border x:Name="Bg" Background="#111115" Opacity="0" CornerRadius="6" Panel.ZIndex="0"/>
                            <Border x:Name="Bar" Width="3" HorizontalAlignment="Left" CornerRadius="0,3,3,0" Background="White" Opacity="0" Panel.ZIndex="1"/>
                            <Grid x:Name="ContentGrid" VerticalAlignment="Center" RenderTransformOrigin="0,0.5" Panel.ZIndex="2">
                                <Grid.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </Grid.RenderTransform>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock x:Name="Label" Grid.Column="1" Text="" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="1" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#888888"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Bg" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="ContentGrid" Storyboard.TargetProperty="(Grid.RenderTransform).(ScaleTransform.ScaleX)" To="1.04" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="ContentGrid" Storyboard.TargetProperty="(Grid.RenderTransform).(ScaleTransform.ScaleY)" To="1.04" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Bg" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/>
                                            <DoubleAnimation Storyboard.TargetName="ContentGrid" Storyboard.TargetProperty="(Grid.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.25"/>
                                            <DoubleAnimation Storyboard.TargetName="ContentGrid" Storyboard.TargetProperty="(Grid.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <ColorAnimation Storyboard.TargetProperty="Foreground.(SolidColorBrush.Color)" To="White" Duration="0:0:0.2">
                                                <ColorAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </ColorAnimation.EasingFunction>
                                            </ColorAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                            <ColorAnimation Storyboard.TargetProperty="Foreground.(SolidColorBrush.Color)" To="#555555" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="WindowBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Border x:Name="Bg" Background="#111111" Opacity="0" CornerRadius="4"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#CCCCCC"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Bg" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(Grid.RenderTransform).(ScaleTransform.ScaleX)" To="1.08" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(Grid.RenderTransform).(ScaleTransform.ScaleY)" To="1.08" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Bg" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(Grid.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(Grid.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(Grid.RenderTransform).(ScaleTransform.ScaleX)" To="0.92" Duration="0:0:0.06"/>
                                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(Grid.RenderTransform).(ScaleTransform.ScaleY)" To="0.92" Duration="0:0:0.06"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(Grid.RenderTransform).(ScaleTransform.ScaleX)" To="1.08" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(Grid.RenderTransform).(ScaleTransform.ScaleY)" To="1.08" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="SideToggleBtn" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="4,2,4,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Border x:Name="Bg" Background="#111111" Opacity="0" CornerRadius="6"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#CCCCCC"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Bg" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(Grid.RenderTransform).(ScaleTransform.ScaleX)" To="1.05" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(Grid.RenderTransform).(ScaleTransform.ScaleY)" To="1.05" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Bg" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(Grid.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(Grid.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>


    <Border x:Name="ClipBorder" Background="Transparent" CornerRadius="8">
        <Border.Clip>
            <RectangleGeometry x:Name="ClipGeometry" RadiusX="8" RadiusY="8"/>
        </Border.Clip>
    <Grid>
        <Border x:Name="RootContent" Background="#080808" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="RootScale" ScaleX="0.94" ScaleY="0.94"/>
            </Border.RenderTransform>
            <Border.Effect>
                <BlurEffect Radius="14"/>
            </Border.Effect>
            <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <Border Grid.Column="0" x:Name="SidebarBorder" Width="48" Background="#0A0A0A" BorderBrush="#1A1A1A" BorderThickness="0,0,1,0" ClipToBounds="True">
                <DockPanel>
                    <StackPanel x:Name="LogoPanel" DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8,0,4">
                        <Image Source="/LeitostrapV7;component/Leitostrap.png" Width="16" Height="16" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock x:Name="NeonTitle" Text="Leitostrap" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="#FFFFFF" Opacity="0.9"/>
                    </StackPanel>


                    <Button x:Name="ToggleSidebarBtn" DockPanel.Dock="Top" Click="ToggleSidebar_Click" Style="{StaticResource SideToggleBtn}">
                        <ui:SymbolIcon x:Name="ToggleArrow" Symbol="ArrowLeft20" FontSize="14" Foreground="#555555"/>
                    </Button>


                    <Border DockPanel.Dock="Top" Height="1" Background="#1A1A1A" Margin="10,0,10,4"/>


                    <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,6">
                        <RadioButton x:Name="NavSettings" Style="{StaticResource NavBtn}" Tag="8" ToolTip="Settings" Checked="Nav_Checked">
                            <ui:SymbolIcon Symbol="Settings20" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </RadioButton>
                        <RadioButton x:Name="NavAbout" Style="{StaticResource NavBtn}" Tag="9" ToolTip="About" Checked="Nav_Checked">
                            <ui:SymbolIcon Symbol="Info20" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </RadioButton>
                    </StackPanel>


                    <StackPanel DockPanel.Dock="Top">
                        <RadioButton x:Name="NavHome" Style="{StaticResource NavBtn}" IsChecked="True" Tag="0" ToolTip="Home" Checked="Nav_Checked">
                            <ui:SymbolIcon Symbol="Home20" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </RadioButton>
                        <RadioButton x:Name="NavFFlags" Style="{StaticResource NavBtn}" Tag="1" ToolTip="Flags" Checked="Nav_Checked">
                            <ui:SymbolIcon Symbol="Edit20" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </RadioButton>
                        <RadioButton x:Name="NavOffsets" Style="{StaticResource NavBtn}" Tag="2" ToolTip="Offsets" Checked="Nav_Checked">
                            <ui:SymbolIcon Symbol="Layer20" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </RadioButton>
                        <RadioButton x:Name="NavProfiles" Style="{StaticResource NavBtn}" Tag="3" ToolTip="Games FFlags" Checked="Nav_Checked">
                            <ui:SymbolIcon Symbol="PuzzlePiece20" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </RadioButton>
                        <RadioButton x:Name="NavCommunityFflags" Style="{StaticResource NavBtn}" Tag="11" ToolTip="Community FFlags" Checked="Nav_Checked">
                            <ui:SymbolIcon Symbol="People20" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </RadioButton>
                        <RadioButton x:Name="NavConsole" Style="{StaticResource NavBtn}" Tag="4" ToolTip="Console" Checked="Nav_Checked">
                            <ui:SymbolIcon Symbol="WindowConsole20" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </RadioButton>
                        <RadioButton x:Name="NavClients" Style="{StaticResource NavBtn}" Tag="5" ToolTip="Clients" Checked="Nav_Checked">
                            <ui:SymbolIcon Symbol="Desktop20" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </RadioButton>
                        <RadioButton x:Name="NavVersions" Style="{StaticResource NavBtn}" Tag="6" ToolTip="Versions" Checked="Nav_Checked">
                            <ui:SymbolIcon Symbol="ArrowDownload20" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </RadioButton>
                        <RadioButton x:Name="NavThemes" Style="{StaticResource NavBtn}" Tag="7" ToolTip="Themes" Checked="Nav_Checked">
                            <ui:SymbolIcon Symbol="Color20" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </RadioButton>
                    </StackPanel>
                </DockPanel>
            </Border>


            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <Grid x:Name="TitleBar" Grid.Row="0" Background="#0A0A0A" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,0,6,0" VerticalAlignment="Center">
                        <Button x:Name="MinimizeBtn" Style="{StaticResource WindowBtn}" Click="MinimizeButton_Click">
                            <ui:SymbolIcon Symbol="Subtract20" FontSize="12"/>
                        </Button>
                        <Button x:Name="MaximizeBtn" Style="{StaticResource WindowBtn}" Click="MaximizeButton_Click">
                            <ui:SymbolIcon x:Name="MaximizeIcon" Symbol="Maximize20" FontSize="12"/>
                        </Button>
                        <Button x:Name="CloseBtn" Style="{StaticResource WindowBtn}" Click="CloseButton_Click">
                            <ui:SymbolIcon Symbol="Dismiss20" FontSize="12"/>
                        </Button>
                    </StackPanel>
                </Grid>


                <Border x:Name="ContentBorder" Grid.Row="1" Background="Black">
                    <ContentControl x:Name="ContentArea">
                        <ContentControl.Resources>
                            <DataTemplate DataType="{x:Type views:HomeView}"><views:HomeView/></DataTemplate>
                            <DataTemplate DataType="{x:Type views:FFlagsEditorView}"><views:FFlagsEditorView/></DataTemplate>
                            <DataTemplate DataType="{x:Type views:OffsetsView}"><views:OffsetsView/></DataTemplate>
                            <DataTemplate DataType="{x:Type views:ProfilesView}"><views:ProfilesView/></DataTemplate>
                            <DataTemplate DataType="{x:Type views:ConsoleView}"><views:ConsoleView/></DataTemplate>
                            <DataTemplate DataType="{x:Type views:RobloxClientsView}"><views:RobloxClientsView/></DataTemplate>
                            <DataTemplate DataType="{x:Type views:VersionsView}"><views:VersionsView/></DataTemplate>
                            <DataTemplate DataType="{x:Type views:ThemesView}"><views:ThemesView/></DataTemplate>
                            <DataTemplate DataType="{x:Type views:SettingsView}"><views:SettingsView/></DataTemplate>
                            <DataTemplate DataType="{x:Type views:AboutView}"><views:AboutView/></DataTemplate>
                            <DataTemplate DataType="{x:Type views:ReadDocsView}"><views:ReadDocsView/></DataTemplate>
                            <DataTemplate DataType="{x:Type views:CommunityFflagsView}"><views:CommunityFflagsView/></DataTemplate>
                        </ContentControl.Resources>
                    </ContentControl>
                </Border>
            </Grid>
        </Grid>
        </Border>


        <Border x:Name="TipBanner" Panel.ZIndex="97" HorizontalAlignment="Center" 
                VerticalAlignment="Top" Margin="0,8,0,0" Background="#1A1A1A" 
                BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="8" 
                Padding="14,6,14,6" Visibility="Collapsed">
            <TextBlock x:Name="TipText" Text="" FontSize="11" Foreground="#CCCCCC"/>
        </Border>


        <StackPanel x:Name="ToastHost" Panel.ZIndex="98" HorizontalAlignment="Right" 
                    VerticalAlignment="Top" Margin="0,12,16,0" MaxWidth="320"/>


        <Canvas x:Name="ParticleCanvas" Panel.ZIndex="1" IsHitTestVisible="False" 
                Background="Transparent" Visibility="Collapsed"/>


        <Grid x:Name="LoadingOverlay" Panel.ZIndex="99">
            <Border Background="#B0000000"/>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image x:Name="LoadingLogo" Source="/LeitostrapV7;component/Leitostrap.png" Width="56" Height="56" HorizontalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <ScaleTransform x:Name="LogoPulse" ScaleX="1" ScaleY="1"/>
                    </Image.RenderTransform>
                </Image>
                <TextBlock x:Name="LoadingTitle" Text="Leitostrap" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,14,0,4" Foreground="{StaticResource NeonGradientBrush}"/>
                <TextBlock x:Name="LoadingStatus" Text="Initializing..." FontSize="11" Foreground="#888888" HorizontalAlignment="Center"/>
                <Border Width="260" Height="3" Background="#111113" CornerRadius="2" Margin="0,18,0,0" ClipToBounds="True">
                    <Border x:Name="LoadingBarFill" Width="0" HorizontalAlignment="Left" CornerRadius="2">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FFFFFF" Offset="0"/>
                                <GradientStop Color="#888888" Offset="0.5"/>
                                <GradientStop Color="#FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
    </Border>
</Window>
