<UserControl x:Class="LeitostrapV7.Views.OffsetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="#000000" Loaded="OnLoaded">
    <UserControl.Resources>
        <Style x:Key="OffsetItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}"
                                CornerRadius="6" Margin="4,2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A1A1A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#222222"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>


    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <TextBlock Grid.Row="0" Text="Offsets Database" FontSize="18" FontWeight="SemiBold" Foreground="White"/>


        <Border Grid.Row="2" Background="#0A0A0A" BorderBrush="#1A1A1A" BorderThickness="1"
                CornerRadius="8" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Source:" FontSize="10" Foreground="#555555"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <ComboBox x:Name="SourceCombo" Grid.Column="1"
                          Background="#050505" Foreground="White"
                          BorderBrush="#1A1A1A" BorderThickness="1"
                          SelectedIndex="0" FontSize="11"
                          SelectionChanged="SourceCombo_SelectionChanged">
                    <ComboBoxItem Content="Cache Offsets"/>
                    <ComboBoxItem Content="Memory Offsets (theo)"/>
                </ComboBox>
            </Grid>
        </Border>


        <Border Grid.Row="4" Background="#0A0A0A" BorderBrush="#1A1A1A" BorderThickness="1"
                CornerRadius="8" Padding="12,8">
            <Grid>
                <ui:SymbolIcon Symbol="Search20" FontSize="11" Foreground="#555555"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0"
                         Foreground="White" FontSize="11" VerticalContentAlignment="Center"
                         CaretBrush="White" Margin="22,0,0,0"
                         TextChanged="SearchBox_TextChanged"/>
            </Grid>
        </Border>


        <Border Grid.Row="6" Background="#0A0A0A" BorderBrush="#1A1A1A" BorderThickness="1"
                CornerRadius="8" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="InfoText" Grid.Column="0" Text="Loading offsets..."
                           FontSize="10" Foreground="#555555" VerticalAlignment="Center"/>
                <TextBlock x:Name="VersionText" Grid.Column="1" Text=""
                           FontSize="10" Foreground="#555555" VerticalAlignment="Center"/>
                <Button x:Name="ReloadBtn" Grid.Column="3" Click="ReloadBtn_Click" Cursor="Hand"
                        Padding="10,5" Background="#0D0D0D" BorderBrush="#2A2A2A" BorderThickness="1"
                        Focusable="False">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowSync20" FontSize="11" Foreground="#AAAAAA" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Reload" FontSize="10.5" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>


        <ListBox x:Name="OffsetList" Grid.Row="7"
                 Background="#050505" BorderBrush="#1A1A1A" BorderThickness="1"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.CacheLength="200"
                 ItemContainerStyle="{StaticResource OffsetItemStyle}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="8,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="11" Foreground="White"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="2" Text="{Binding Value}" FontSize="10" Foreground="#888888"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
