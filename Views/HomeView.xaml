<UserControl x:Class="LeitostrapV7.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="Black">


    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border" BasedOn="{StaticResource AnimatedCard}"/>


        <Style x:Key="CardBtn" TargetType="Button" BasedOn="{StaticResource ModernBtn}"/>


        <Style x:Key="ActionBtn" TargetType="Button" BasedOn="{StaticResource ModernGreenBtn}"/>


        <Style x:Key="RedActionBtn" TargetType="Button" BasedOn="{StaticResource ModernRedBtn}"/>


        <Style x:Key="ToggleTrack" TargetType="Border">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>


        <Style x:Key="ToggleKnob" TargetType="Border">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>


    <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Black">
        <StackPanel Margin="24,18">
            <TextBlock Text="Home" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,14"/>


            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="CACHE OFFSETS" FontSize="8.5" FontWeight="Bold" Foreground="#333" Margin="0,0,0,4"/>
                        <TextBlock x:Name="CacheOffsetsCount" Text="38,448" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,8"/>
                        <Button Style="{StaticResource CardBtn}" HorizontalAlignment="Left" Click="ReloadCacheOffsets_Click">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowSync20" FontSize="14" Margin="0,0,5,0"/>
                                <TextBlock Text="Reload"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>


                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="MEMORY OFFSETS" FontSize="8.5" FontWeight="Bold" Foreground="#333" Margin="0,0,0,4"/>
                        <TextBlock x:Name="MemoryOffsetsCount" Text="14,341" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,8"/>
                        <Button Style="{StaticResource CardBtn}" HorizontalAlignment="Left" Click="ReloadMemoryOffsets_Click">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowSync20" FontSize="14" Margin="0,0,5,0"/>
                                <TextBlock Text="Reload"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>


            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="ROBLOX VERSION" FontSize="8.5" FontWeight="Bold" Foreground="#333" Margin="0,0,0,4"/>
                        <TextBlock x:Name="RobloxVersionText" Text="Checking..." FontSize="13" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Ellipse x:Name="RobloxStatusDot" Width="5" Height="5" Fill="#333" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="RobloxStatusText" Text="Checking..." FontSize="10" Foreground="#444" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Style="{StaticResource CardBtn}" HorizontalAlignment="Left" Click="BrowseRobloxExe_Click">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="OpenFolder20" FontSize="14" Margin="0,0,5,0"/>
                                <TextBlock Text="Browse"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>


                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="FASTFLAGS LOADED" FontSize="8.5" FontWeight="Bold" Foreground="#333" Margin="0,0,0,4"/>
                        <TextBlock x:Name="FFlagsLoadedCount" Text="0" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,8"/>
                        <Button Style="{StaticResource CardBtn}" HorizontalAlignment="Left" Click="ImportFFlags_Click">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="DocumentArrowDown20" FontSize="14" Margin="0,0,5,0"/>
                                <TextBlock Text="Import"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>


            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="TUTORIAL" FontSize="8.5" FontWeight="Bold" Foreground="#333" Margin="0,0,0,4"/>
                        <TextBlock Text="How To Use?" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,8"/>
                        <Button Style="{StaticResource CardBtn}" HorizontalAlignment="Left" Click="ReadDocs_Click">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="BookQuestionMark20" FontSize="14" Margin="0,0,5,0"/>
                                <TextBlock Text="Read Docs"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>


                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="FFLAGS INJECTED" FontSize="8.5" FontWeight="Bold" Foreground="#333" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="FFlagsInjectedCount" Text="0" Grid.Column="0" FontSize="24" FontWeight="Bold" Foreground="White"/>
                            <TextBlock x:Name="FFlagsInjectedSeparator" Text="/" Grid.Column="1" FontSize="16" FontWeight="Bold" Foreground="#333" VerticalAlignment="Center" Margin="0,2,0,0"/>
                            <TextBlock x:Name="FFlagsInjectedTotal" Text="0" Grid.Column="2" FontSize="16" FontWeight="SemiBold" Foreground="#555" VerticalAlignment="Center" Margin="0,2,0,0"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="InjectedDot" Width="5" Height="5" Grid.Column="0" Fill="#333" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock x:Name="InjectedStatus" Text="No flags injected" Grid.Column="1" FontSize="9.5" Foreground="#444" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>


            <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="COMMUNITY" FontSize="8.5" FontWeight="Bold" Foreground="#333" Margin="0,0,0,4"/>
                        <TextBlock Text="Join our community" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                    <Button DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Click="JoinDiscord_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="#0A0A0A" CornerRadius="6" BorderBrush="#1A1A1A" BorderThickness="1" Padding="12,5">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="People20" FontSize="12" Margin="0,0,5,0" Foreground="#555"/>
                                        <TextBlock Text="Join Discord" FontSize="10" FontWeight="SemiBold" Foreground="#555"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#111"/>
                                        <Setter TargetName="b" Property="BorderBrush" Value="#222"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </DockPanel>
            </Border>


            <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="18,12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="Smart Mode" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Text="Auto-reapply flags when Roblox restarts" FontSize="9.5" Foreground="#444" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource ToggleTrack}"
                            MouseLeftButtonDown="SmartModeToggle_Click">
                        <Border x:Name="SmartModeKnob" Style="{StaticResource ToggleKnob}" HorizontalAlignment="Left" Margin="2,0,0,0"/>
                    </Border>
                </DockPanel>
            </Border>


            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <Button Grid.Column="0" Style="{StaticResource ActionBtn}" HorizontalAlignment="Stretch" Click="ApplyFlags_Click">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Play20" FontSize="14" Margin="0,0,5,0"/>
                        <TextBlock Text="Apply FastFlags" Foreground="White"/>
                    </StackPanel>
                </Button>


                <Button Grid.Column="2" Style="{StaticResource RedActionBtn}" HorizontalAlignment="Stretch" Click="UnapplyFlags_Click">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Dismiss20" FontSize="14" Margin="0,0,5,0"/>
                        <TextBlock Text="Unapply"/>
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>
    </ScrollViewer>


    <Border x:Name="ViewFFlagsOverlay" Visibility="Collapsed" Background="#CC000000"
            Panel.ZIndex="50" MouseLeftButtonDown="CloseViewFFlags_Click">
        <Border Background="#0A0A0A" BorderBrush="#1A1A1A" BorderThickness="1"
                CornerRadius="10" Padding="16" Margin="40,30"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <Grid Grid.Row="0">
                    <TextBlock Text="Injected FastFlags" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                    <Button x:Name="CloseViewFFlagsBtn" HorizontalAlignment="Right" Style="{StaticResource CardBtn}"
                            Click="CloseViewFFlags_Click" Padding="8,4">
                        <ui:SymbolIcon Symbol="Dismiss20" FontSize="12"/>
                    </Button>
                </Grid>


                <TextBlock Grid.Row="1" x:Name="ViewFFlagsCount" Text="0 flags injected" FontSize="10" Foreground="#555555"/>


                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ViewFFlagsList"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Border>


    <Border x:Name="ApplyOverlay" Visibility="Collapsed" Background="#00000000"
            Panel.ZIndex="50" IsHitTestVisible="True">
        <Grid>
            <Border x:Name="ApplyOverlayDim" Background="#CC000000"/>
            <Border x:Name="ApplyCard" Background="#0C0C0E" BorderBrush="#1A1A1E" BorderThickness="1"
                    CornerRadius="14" Padding="32,28" Margin="60,50"
                    HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="340" MaxWidth="420"
                    RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="ApplyCardScale" ScaleX="0.92" ScaleY="0.92"/>
                    <TranslateTransform x:Name="ApplyCardSlide" Y="20"/>
                </TransformGroup>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="White" Opacity="0.03"/>
            </Border.Effect>


            <StackPanel>
                <Grid HorizontalAlignment="Center" Margin="0,0,0,14">
                    <Ellipse x:Name="ApplyStatusRing" Width="52" Height="52" StrokeThickness="2"
                             Stroke="#FFFFFF" Fill="#0C0C0E"/>
                    <Ellipse x:Name="ApplyStatusDot" Width="52" Height="52" StrokeThickness="2"
                             Stroke="#333" Fill="#0C0C0E"/>
                    <ui:SymbolIcon x:Name="ApplyStatusIcon" Symbol="Play20" FontSize="22"
                                   Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>


                <TextBlock x:Name="ApplyTitleText" Text="Preparing..." FontSize="16" FontWeight="SemiBold"
                           Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,4"/>


                <TextBlock x:Name="ApplyStatusText" Text="" FontSize="11.5"
                           Foreground="#666666" HorizontalAlignment="Center" Margin="0,0,0,18" TextWrapping="Wrap"/>


                <Border x:Name="ApplyProgressTrack" Background="#161618" CornerRadius="4" Height="4" ClipToBounds="True" Margin="0,0,0,14">
                    <Border x:Name="ApplyProgressFill" Width="0" HorizontalAlignment="Left" CornerRadius="4">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FFFFFF" Offset="0"/>
                                <GradientStop Color="#AAAAAA" Offset="0.5"/>
                                <GradientStop Color="#FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Border>


                <Grid Margin="0,0,0,0">
                    <TextBlock x:Name="ApplyCountText" Text="" FontSize="12" FontWeight="SemiBold"
                               Foreground="#888888" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="ApplyMethodText" Text="" FontSize="10"
                               Foreground="#444444" HorizontalAlignment="Right"/>
                </Grid>


                <Border x:Name="ApplyResultBorder" Visibility="Collapsed" CornerRadius="8"
                        Padding="14,10" Margin="0,14,0,0" HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon x:Name="ApplyResultIcon" Symbol="CheckmarkCircle20" FontSize="16"
                                       Foreground="#FFFFFF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ApplyResultText" Text="" FontSize="11"
                                   Foreground="#CCCCCC" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
        </Grid>
    </Border>
    </Grid>
</UserControl>
