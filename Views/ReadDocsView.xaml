<UserControl x:Class="LeitostrapV7.Views.ReadDocsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="#080808">
    <UserControl.Resources>
        <Style x:Key="StepCard" TargetType="Border">
            <Setter Property="Background" Value="#111111"/>
            <Setter Property="BorderBrush" Value="#1A1A1A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="StepNum" TargetType="Border">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#080808" BorderBrush="#1A1A1A" BorderThickness="0,0,0,1" Padding="20,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#111111" BorderBrush="#1A1A1A" BorderThickness="1" CornerRadius="6"
                        Width="28" Height="28" Cursor="Hand" MouseLeftButtonDown="Back_Click" Margin="0,0,12,0">
                    <ui:SymbolIcon Symbol="ArrowLeft20" FontSize="14" Foreground="#888888"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Read Docs" FontSize="16" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,18">
                <Border Style="{StaticResource StepCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Background="#1A1A1A" CornerRadius="6" Width="32" Height="32" Margin="0,0,10,0">
                                <ui:SymbolIcon Symbol="BookQuestionMark20" FontSize="16" Foreground="#888888"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="What is Leitostrap?" FontSize="15" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Leitostrap is an advanced FastFlags injector for Roblox. It allows you to modify Roblox client settings to improve performance, graphics, and overall experience. Choose one of the injection methods below to get started."
                                   FontSize="11" Foreground="#888888" TextWrapping="Wrap" LineHeight="18"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StepCard}">
                    <StackPanel>
                        <Border Background="#1A1A1A" CornerRadius="10" Padding="8,3" HorizontalAlignment="Left" Margin="0,0,0,8">
                            <TextBlock Text="RECOMMENDED" FontSize="8" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </Border>
                        <TextBlock Text="1. Memory Offsets (Recommended)" FontSize="13" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,10"/>
                        <TextBlock Text="1. Go to Settings and select Memory Offsets (theo's database)&#x0a;2. The offset database is loaded automatically&#x0a;3. Import or create your FastFlags in the editor&#x0a;4. Start Roblox and click Apply FastFlags&#x0a;5. Uses offset database for direct memory writes - best performance"
                                   FontSize="11" Foreground="#888888" TextWrapping="Wrap" LineHeight="22"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StepCard}">
                    <StackPanel>
                        <TextBlock Text="2. Cache Method" FontSize="13" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,10"/>
                        <TextBlock Text="1. Go to Settings and select Cache Method&#x0a;2. Import your flags or use a profile&#x0a;3. Start Roblox and click Apply&#x0a;4. Modifies Roblox client settings only (no memory writes)"
                                   FontSize="11" Foreground="#888888" TextWrapping="Wrap" LineHeight="22"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StepCard}">
                    <StackPanel>
                        <TextBlock Text="3. Combined" FontSize="13" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,10"/>
                        <TextBlock Text="1. Go to Settings and select Combined&#x0a;2. Import your flags or use a profile&#x0a;3. Start Roblox and click Apply&#x0a;4. Combines both cache and memory injection for maximum compatibility"
                                   FontSize="11" Foreground="#888888" TextWrapping="Wrap" LineHeight="22"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StepCard}">
                    <StackPanel>
                        <TextBlock Text="4. Memory Offsetless" FontSize="13" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,10"/>
                        <TextBlock Text="1. Go to Settings and select Memory Offsetless (pattern scan)&#x0a;2. No offset database required&#x0a;3. Start Roblox and click Apply&#x0a;4. Scans memory patterns at runtime - works across versions"
                                   FontSize="11" Foreground="#888888" TextWrapping="Wrap" LineHeight="22"/>
                    </StackPanel>
                </Border>
                <Border Background="#1A1208" BorderBrush="#3D2A0A" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Important" FontSize="13" FontWeight="SemiBold" Foreground="#F59E0B" Margin="0,0,0,8"/>
                        <TextBlock Text="Leitostrap is for educational purposes only. Using injectors may violate Roblox Terms of Service. Use at your own risk. Always keep your antivirus exceptions updated and run as administrator if needed."
                                   FontSize="11" Foreground="#F59E0B" TextWrapping="Wrap" Opacity="0.8"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
