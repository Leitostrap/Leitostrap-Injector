<UserControl x:Class="LeitostrapV7.Views.CommunityFflagsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{StaticResource Bg}" Loaded="OnLoaded">
    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <ui:SymbolIcon Symbol="People20" FontSize="18" Foreground="#FFFFFF" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock Text="Community FFlags" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" VerticalAlignment="Center"/>
        </StackPanel>


        <Border Grid.Row="2" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" 
                CornerRadius="6" Padding="10,5">
            <Grid>
                <ui:SymbolIcon Symbol="Search20" FontSize="11" Foreground="{StaticResource TextDim}" 
                           VerticalAlignment="Center" IsHitTestVisible="False"/>
                <TextBox x:Name="CommunitySearchBox" Background="Transparent" BorderThickness="0" 
                         Foreground="{StaticResource TextMain}" FontSize="11" VerticalContentAlignment="Center"
                         CaretBrush="{StaticResource TextMain}" Margin="20,0,0,0"
                         TextChanged="CommunitySearchBox_TextChanged"/>
            </Grid>
        </Border>


        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="CommunityPanel">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>


        <Border Grid.Row="5" Background="#050505" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" 
                CornerRadius="6" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="CommunityStatusText" Grid.Column="0" Text="Loading community fflags..." 
                           FontSize="10" Foreground="{StaticResource TextDim}" VerticalAlignment="Center"/>
                <TextBlock x:Name="CommunityCountText" Grid.Column="1" Text="" 
                           FontSize="10" Foreground="{StaticResource TextDim}" VerticalAlignment="Center"/>
            </Grid>
        </Border>


        <Grid x:Name="PreviewOverlay" Visibility="Collapsed" Panel.ZIndex="100">
            <Border Background="#80000000" MouseLeftButtonDown="ClosePreview_Click"/>
            <Border x:Name="PreviewContainer" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="480" MaxHeight="520" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderLight}"
                    BorderThickness="1" CornerRadius="12" Padding="24,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="People20" FontSize="14" Foreground="#FFFFFF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="PreviewEntryName" Text="" FontSize="16" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>


                    <Border Grid.Row="2" Background="#080808" BorderBrush="{StaticResource BorderLight}" BorderThickness="1"
                            CornerRadius="4" Padding="8,3" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Document20" FontSize="9" Foreground="{StaticResource TextDim}" Margin="0,0,5,0"/>
                            <TextBlock x:Name="PreviewFlagCount" Text="" FontSize="9" Foreground="{StaticResource TextDim}"/>
                        </StackPanel>
                    </Border>


                    <Border Grid.Row="4" Background="#050505" BorderBrush="{StaticResource BorderLight}" BorderThickness="1"
                            CornerRadius="8" Padding="12,8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBox x:Name="PreviewJsonBox" Background="Transparent" BorderThickness="0"
                                     Foreground="#FFFFFF" FontFamily="Consolas" FontSize="9"
                                     IsReadOnly="True" TextWrapping="Wrap" Text=""/>
                        </ScrollViewer>
                    </Border>


                    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Close" Style="{StaticResource ModernBtn}" 
                                Click="ClosePreviewBtn_Click" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource ModernGreenBtn}" Foreground="White"
                                Click="PreviewAdd_Click">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Add20" FontSize="11" Margin="0,0,5,0"/>
                                <TextBlock Text="Add to Editor" FontSize="10"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
