<UserControl x:Class="LeitostrapV7.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="800"
             Loaded="OnLoaded"
             Background="#080808">


    <UserControl.Resources>
        <Style x:Key="AvatarBorder" TargetType="Border">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
            <Setter Property="Background" Value="#1A1A1A"/>
        </Style>


        <Style x:Key="SmallAvatarBorder" TargetType="Border">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="CornerRadius" Value="19"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="Background" Value="#1A1A1A"/>
        </Style>
    </UserControl.Resources>


    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24" MaxWidth="900" HorizontalAlignment="Center">


            <Border x:Name="LogoCard" Background="#111111" CornerRadius="16" Padding="36,32" Margin="0,0,0,16"
                    HorizontalAlignment="Center" BorderBrush="#1A1A1A" BorderThickness="1"
                    RenderTransformOrigin="0.5,0.5" Opacity="0">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="0.9" ScaleY="0.9"/>
                        <TranslateTransform Y="20"/>
                    </TransformGroup>
                </Border.RenderTransform>
                <StackPanel HorizontalAlignment="Center">
                    <Image Source="/LeitostrapV7;component/Leitostrap.png"
                           Width="90" Height="90" Stretch="UniformToFill"
                           HorizontalAlignment="Center" Margin="0,0,0,12"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Leitostrap" FontSize="30" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" Margin="0,0,0,2"/>
                    <TextBlock Text="V7.0.0" FontSize="13" Foreground="#F59E0B" FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="The most advanced Roblox FastFlags injector"
                               FontSize="12" Foreground="#777777" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>


            <TextBlock x:Name="DescText"
                       Text="4 injection methods, 95+ themes, Smart Mode auto-injection, live process monitoring, and a built-in HWID spoofer."
                       FontSize="13" Foreground="#888888" TextWrapping="Wrap" TextAlignment="Center"
                       Margin="0,0,0,20" LineHeight="20" Opacity="0"/>


            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <Border x:Name="Feature1" Grid.Row="0" Grid.Column="0"
                        Background="#111111" CornerRadius="12" Padding="20" Margin="5"
                        BorderBrush="#1A1A1A" BorderThickness="1"
                        RenderTransformOrigin="0.5,0.5" Opacity="0"
                        MouseEnter="Card_MouseEnter" MouseLeave="Card_MouseLeave">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="0.92" ScaleY="0.92"/>
                            <TranslateTransform Y="15"/>
                        </TransformGroup>
                    </Border.RenderTransform>
                    <StackPanel>
                        <Border Width="36" Height="36" CornerRadius="8" Background="#2A1F0A" HorizontalAlignment="Left" Margin="0,0,0,10">
                            <ui:SymbolIcon Symbol="Layer20" FontSize="18" Foreground="#F59E0B"/>
                        </Border>
                        <TextBlock Text="Injection Engine" FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,4"/>
                        <TextBlock Text="Cache + Memory combined with 4 methods. Watchdog, Auto Reopen, Advanced Features" FontSize="11.5" Foreground="#888888" TextWrapping="Wrap" LineHeight="17"/>
                    </StackPanel>
                </Border>


                <Border x:Name="Feature2" Grid.Row="0" Grid.Column="1"
                        Background="#111111" CornerRadius="12" Padding="20" Margin="5"
                        BorderBrush="#1A1A1A" BorderThickness="1"
                        RenderTransformOrigin="0.5,0.5" Opacity="0"
                        MouseEnter="Card_MouseEnter" MouseLeave="Card_MouseLeave">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="0.92" ScaleY="0.92"/>
                            <TranslateTransform Y="15"/>
                        </TransformGroup>
                    </Border.RenderTransform>
                    <StackPanel>
                        <Border Width="36" Height="36" CornerRadius="8" Background="#0A1A2A" HorizontalAlignment="Left" Margin="0,0,0,10">
                            <ui:SymbolIcon Symbol="Edit20" FontSize="18" Foreground="#3B82F6"/>
                        </Border>
                        <TextBlock Text="FFlag Editor" FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,4"/>
                        <TextBlock Text="Full editor with tabs, search, import/export, offsets database, explorer and profiles" FontSize="11.5" Foreground="#888888" TextWrapping="Wrap" LineHeight="17"/>
                    </StackPanel>
                </Border>


                <Border x:Name="Feature3" Grid.Row="1" Grid.Column="0"
                        Background="#111111" CornerRadius="12" Padding="20" Margin="5"
                        BorderBrush="#1A1A1A" BorderThickness="1"
                        RenderTransformOrigin="0.5,0.5" Opacity="0"
                        MouseEnter="Card_MouseEnter" MouseLeave="Card_MouseLeave">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="0.92" ScaleY="0.92"/>
                            <TranslateTransform Y="15"/>
                        </TransformGroup>
                    </Border.RenderTransform>
                    <StackPanel>
                        <Border Width="36" Height="36" CornerRadius="8" Background="#1A0A2A" HorizontalAlignment="Left" Margin="0,0,0,10">
                            <ui:SymbolIcon Symbol="Color20" FontSize="18" Foreground="#A855F7"/>
                        </Border>
                        <TextBlock Text="95+ Themes" FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,4"/>
                        <TextBlock Text="60 Static Themes, 35 Animated Themes, Custom Backgrounds, Full Propagation" FontSize="11.5" Foreground="#888888" TextWrapping="Wrap" LineHeight="17"/>
                    </StackPanel>
                </Border>


                <Border x:Name="Feature4" Grid.Row="1" Grid.Column="1"
                        Background="#111111" CornerRadius="12" Padding="20" Margin="5"
                        BorderBrush="#1A1A1A" BorderThickness="1"
                        RenderTransformOrigin="0.5,0.5" Opacity="0"
                        MouseEnter="Card_MouseEnter" MouseLeave="Card_MouseLeave">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="0.92" ScaleY="0.92"/>
                            <TranslateTransform Y="15"/>
                        </TransformGroup>
                    </Border.RenderTransform>
                    <StackPanel>
                        <Border Width="36" Height="36" CornerRadius="8" Background="#0A2A1A" HorizontalAlignment="Left" Margin="0,0,0,10">
                            <ui:SymbolIcon Symbol="Desktop20" FontSize="18" Foreground="#FFFFFF"/>
                        </Border>
                        <TextBlock Text="Extras &amp; Tools" FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,4"/>
                        <TextBlock Text="Discord RPC, Overlay Hotkey, HWID Spoofer, UI Sounds, Console, Versions Manager" FontSize="11.5" Foreground="#888888" TextWrapping="Wrap" LineHeight="17"/>
                    </StackPanel>
                </Border>
            </Grid>


            <Border x:Name="AvCard"
                    Background="#111111" CornerRadius="12" Padding="20" Margin="5"
                    BorderBrush="#1A1A1A" BorderThickness="1"
                    RenderTransformOrigin="0.5,0.5" Opacity="0"
                    MouseEnter="Card_MouseEnter" MouseLeave="Card_MouseLeave">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="0.92" ScaleY="0.92"/>
                        <TranslateTransform Y="15"/>
                    </TransformGroup>
                </Border.RenderTransform>
                <StackPanel Orientation="Horizontal">
                    <Border Width="36" Height="36" CornerRadius="8" Background="#2A1A0A" Margin="0,0,14,0" VerticalAlignment="Top">
                        <ui:SymbolIcon Symbol="Warning20" FontSize="18" Foreground="#F59E0B"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Antivirus False Positives" FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,4"/>
                        <TextBlock Text="Most antiviruses flag this as a hack tool. Add an exception to run it." FontSize="11.5" Foreground="#888888" TextWrapping="Wrap" LineHeight="17"/>
                    </StackPanel>
                </StackPanel>
            </Border>


            <StackPanel Margin="0,24,0,0">
                <StackPanel x:Name="CreditsHeader" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16" Opacity="0">
                    <ui:SymbolIcon Symbol="People20" FontSize="18" Foreground="#F59E0B" Margin="0,0,8,0"/>
                    <TextBlock Text="Team" FontSize="20" FontWeight="SemiBold" Foreground="White"/>
                </StackPanel>


                <Border x:Name="OwnerCard" CornerRadius="14" Background="#111111" Padding="20" Margin="0,0,0,10"
                        HorizontalAlignment="Center" Width="540" BorderThickness="1.5" Opacity="0"
                        RenderTransformOrigin="0.5,0.5"
                        MouseEnter="Card_MouseEnter" MouseLeave="Card_MouseLeave">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="0.94" ScaleY="0.94"/>
                            <TranslateTransform Y="12"/>
                        </TransformGroup>
                    </Border.RenderTransform>
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#F59E0B" Offset="0"/>
                            <GradientStop Color="#D97706" Offset="0.5"/>
                            <GradientStop Color="#F59E0B" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>


                        <Ellipse Grid.Column="0" Width="44" Height="44" Margin="0,0,14,0" StrokeThickness="2">
                            <Ellipse.Fill>
                                <ImageBrush x:Name="AvatarLeito" ImageSource="{x:Null}" Stretch="UniformToFill"/>
                            </Ellipse.Fill>
                            <Ellipse.Stroke>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#F59E0B" Offset="0"/>
                                    <GradientStop Color="#D97706" Offset="1"/>
                                </LinearGradientBrush>
                            </Ellipse.Stroke>
                        </Ellipse>


                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Leito" FontSize="16" FontWeight="SemiBold" Foreground="#F59E0B"/>
                            <TextBlock Text="Owner &amp; Lead Developer" FontSize="11.5" Foreground="#888888" Margin="0,2,0,0"/>
                        </StackPanel>


                        <Border Grid.Column="2" Background="#2A1F0A" CornerRadius="6" Padding="10,5" VerticalAlignment="Center">
                            <TextBlock Text="Owner" FontSize="11" FontWeight="SemiBold" Foreground="#F59E0B"/>
                        </Border>
                    </Grid>
                </Border>


                <Border x:Name="DevsCard" BorderBrush="#222222" BorderThickness="1" CornerRadius="14"
                        Background="#111111" Padding="20" Margin="0,0,0,10"
                        HorizontalAlignment="Center" Width="540" Opacity="0"
                        RenderTransformOrigin="0.5,0.5"
                        MouseEnter="Card_MouseEnter" MouseLeave="Card_MouseLeave">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="0.94" ScaleY="0.94"/>
                            <TranslateTransform Y="12"/>
                        </TransformGroup>
                    </Border.RenderTransform>
                    <StackPanel>
                        <TextBlock Text="Developers" FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,14"/>


                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Ellipse Width="38" Height="38" Margin="0,0,12,0" Stroke="#3B82F6" StrokeThickness="1.5">
                                <Ellipse.Fill>
                                    <ImageBrush x:Name="AvatarLean" ImageSource="{x:Null}" Stretch="UniformToFill"/>
                                </Ellipse.Fill>
                            </Ellipse>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Lean" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock Text="Developer" FontSize="11" Foreground="#888888" Margin="0,1,0,0"/>
                            </StackPanel>
                        </StackPanel>


                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Ellipse Width="38" Height="38" Margin="0,0,12,0" Stroke="#A855F7" StrokeThickness="1.5">
                                <Ellipse.Fill>
                                    <ImageBrush x:Name="AvatarWinnie" ImageSource="{x:Null}" Stretch="UniformToFill"/>
                                </Ellipse.Fill>
                            </Ellipse>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Winnie" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock Text="Developer" FontSize="11" Foreground="#888888" Margin="0,1,0,0"/>
                            </StackPanel>
                        </StackPanel>


                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Ellipse Width="38" Height="38" Margin="0,0,12,0" Stroke="#FFFFFF" StrokeThickness="1.5">
                                <Ellipse.Fill>
                                    <ImageBrush x:Name="AvatarPrezone" ImageSource="{x:Null}" Stretch="UniformToFill"/>
                                </Ellipse.Fill>
                            </Ellipse>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Prezone" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock Text="Developer" FontSize="11" Foreground="#888888" Margin="0,1,0,0"/>
                            </StackPanel>
                        </StackPanel>


                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="38" Height="38" Margin="0,0,12,0" Stroke="#EF4444" StrokeThickness="1.5">
                                <Ellipse.Fill>
                                    <ImageBrush x:Name="AvatarDem" ImageSource="{x:Null}" Stretch="UniformToFill"/>
                                </Ellipse.Fill>
                            </Ellipse>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Dem" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock Text="Developer" FontSize="11" Foreground="#888888" Margin="0,1,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>


                <Border x:Name="ThanksCard" BorderBrush="#222222" BorderThickness="1" CornerRadius="14"
                        Background="#111111" Padding="20" Margin="0,0,0,10"
                        HorizontalAlignment="Center" Width="540" Opacity="0"
                        RenderTransformOrigin="0.5,0.5"
                        MouseEnter="Card_MouseEnter" MouseLeave="Card_MouseLeave">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="0.94" ScaleY="0.94"/>
                            <TranslateTransform Y="12"/>
                        </TransformGroup>
                    </Border.RenderTransform>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Background="#2A1F0A" CornerRadius="6" Padding="10,5">
                                <TextBlock Text="Special Thanks" FontSize="11" FontWeight="SemiBold" Foreground="#F59E0B"/>
                            </Border>
                        </StackPanel>


                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="38" Height="38" Margin="0,0,12,0" Stroke="#F59E0B" StrokeThickness="1.5">
                                <Ellipse.Fill>
                                    <ImageBrush x:Name="AvatarTheo" ImageSource="{x:Null}" Stretch="UniformToFill"/>
                                </Ellipse.Fill>
                            </Ellipse>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Theo" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock Text="Offsets Provider" FontSize="11" Foreground="#888888" Margin="0,1,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>


            <StackPanel x:Name="LinksSection" Margin="0,28,0,28" Opacity="0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14">
                    <TextBlock Text="Links" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                </StackPanel>


                <WrapPanel HorizontalAlignment="Center">
                    <Border x:Name="LinkWebsite" Cursor="Hand"
                            Background="#111111" CornerRadius="12" Padding="22,14" Margin="5"
                            Width="180" HorizontalAlignment="Center"
                            BorderBrush="#1A1A1A" BorderThickness="1"
                            RenderTransformOrigin="0.5,0.5"
                            MouseLeftButtonDown="Website_Click"
                            MouseEnter="Link_MouseEnter" MouseLeave="Link_MouseLeave">
                        <Border.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                <TranslateTransform Y="0"/>
                            </TransformGroup>
                        </Border.RenderTransform>
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="36" Height="36" CornerRadius="8" Background="#0A1A2A"
                                    HorizontalAlignment="Center" Margin="0,0,0,8">
                                <ui:SymbolIcon Symbol="Globe20" FontSize="17" Foreground="#3B82F6"/>
                            </Border>
                            <TextBlock Text="Website" FontSize="12" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"/>
                            <TextBlock Text="leitostrap.netlify.app" FontSize="10" Foreground="#666666" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>


                    <Border x:Name="LinkDiscord" Cursor="Hand"
                            Background="#111111" CornerRadius="12" Padding="22,14" Margin="5"
                            Width="180" HorizontalAlignment="Center"
                            BorderBrush="#1A1A1A" BorderThickness="1"
                            RenderTransformOrigin="0.5,0.5"
                            MouseLeftButtonDown="Discord_Click"
                            MouseEnter="Link_MouseEnter" MouseLeave="Link_MouseLeave">
                        <Border.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                <TranslateTransform Y="0"/>
                            </TransformGroup>
                        </Border.RenderTransform>
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="36" Height="36" CornerRadius="8" Background="#1A0A2A"
                                    HorizontalAlignment="Center" Margin="0,0,0,8">
                                <ui:SymbolIcon Symbol="Chat20" FontSize="17" Foreground="#5865F2"/>
                            </Border>
                            <TextBlock Text="Discord" FontSize="12" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"/>
                            <TextBlock Text="Join the community" FontSize="10" Foreground="#666666" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>


                    <Border x:Name="LinkGitHub" Cursor="Hand"
                            Background="#111111" CornerRadius="12" Padding="22,14" Margin="5"
                            Width="180" HorizontalAlignment="Center"
                            BorderBrush="#1A1A1A" BorderThickness="1"
                            RenderTransformOrigin="0.5,0.5"
                            MouseLeftButtonDown="GitHub_Click"
                            MouseEnter="Link_MouseEnter" MouseLeave="Link_MouseLeave">
                        <Border.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                <TranslateTransform Y="0"/>
                            </TransformGroup>
                        </Border.RenderTransform>
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="36" Height="36" CornerRadius="8" Background="#0A2A1A"
                                    HorizontalAlignment="Center" Margin="0,0,0,8">
                                <ui:SymbolIcon Symbol="Code20" FontSize="17" Foreground="#FFFFFF"/>
                            </Border>
                            <TextBlock Text="GitHub" FontSize="12" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"/>
                            <TextBlock Text="Open source" FontSize="10" Foreground="#666666" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </StackPanel>


        </StackPanel>
    </ScrollViewer>
</UserControl>
