<UserControl x:Class="LeitostrapV7.Views.VersionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="#000000">
    <UserControl.Resources>
        <SolidColorBrush x:Key="CardBg" Color="#0A0A0A"/>
        <SolidColorBrush x:Key="Bdr" Color="#1A1A1A"/>
        <SolidColorBrush x:Key="T1" Color="White"/>
        <SolidColorBrush x:Key="T2" Color="#555555"/>
        <SolidColorBrush x:Key="Green" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Red" Color="#EF4444"/>
        <SolidColorBrush x:Key="SupportedGreen" Color="#FFFFFF"/>


        <Style x:Key="CardBtn" TargetType="Button" BasedOn="{StaticResource ModernBtn}"/>
        <Style x:Key="GreenBtn" TargetType="Button" BasedOn="{StaticResource ModernGreenBtn}"/>
        <Style x:Key="RedBtn" TargetType="Button" BasedOn="{StaticResource ModernRedBtn}"/>


        <Style x:Key="SupportedBadge" TargetType="Border">
            <Setter Property="Background" Value="#142218"/>
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>


    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Black">
        <StackPanel Margin="20,16">
            <Grid Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="ArrowDownload20" FontSize="18" Foreground="{StaticResource Green}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Roblox Versions" FontSize="18" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
                <Button x:Name="RefreshBtn" Style="{StaticResource CardBtn}" HorizontalAlignment="Right" Click="RefreshBtn_Click">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon x:Name="RefreshIcon" Symbol="ArrowSync20" FontSize="11" Margin="0,0,5,0"/>
                        <TextBlock Text="Refresh" FontSize="10"/>
                    </StackPanel>
                </Button>
            </Grid>


            <TextBlock Text="DOWNLOAD" FontSize="9" FontWeight="Bold" Foreground="#555555" Margin="0,0,0,8"/>


            <Border Background="#0A0A0A" BorderBrush="#1A1A1A" BorderThickness="1"
                    CornerRadius="10" Padding="16" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>


                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="10"
                            Background="#111111" ClipToBounds="True" VerticalAlignment="Center">
                        <Image Source="/LeitostrapV7;component/Resources/Roblox.png"
                               Width="46" Height="46" Stretch="UniformToFill"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>


                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Roblox" FontSize="15" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Text="Roblox Corporation" FontSize="10" Foreground="#666666" Margin="0,1,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock x:Name="DownloadVersionText" Text="Checking..." FontSize="10" Foreground="#888888" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource SupportedBadge}" Margin="8,0,0,0">
                                <TextBlock Text="Supported" FontSize="8" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>


                    <Button Grid.Column="3" x:Name="DownloadLaunchBtn" Style="{StaticResource GreenBtn}"
                            Click="LaunchBtn_Click" VerticalAlignment="Center" Margin="12,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Play20" FontSize="12" Margin="0,0,5,0"/>
                            <TextBlock Text="Launch" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>


            <Border Background="#0A0A0A" BorderBrush="#1A1A1A" BorderThickness="1"
                    CornerRadius="10" Padding="12" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>


                    <ui:SymbolIcon Grid.Column="0" Symbol="Document20" FontSize="14"
                                   Foreground="#555555" VerticalAlignment="Center"/>


                    <TextBlock Grid.Column="2" x:Name="BrowsePathText"
                               Text="Select RobloxPlayerBeta.exe"
                               FontSize="11" Foreground="#444444" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>


                    <Button Grid.Column="4" x:Name="BrowseBtn" Style="{StaticResource CardBtn}"
                            Click="BrowseBtn_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="OpenFolder20" FontSize="11" Margin="0,0,5,0"/>
                            <TextBlock Text="Browse" FontSize="10"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>


            <Grid Margin="0,4,0,8">
                <TextBlock Text="INSTALLED VERSIONS" FontSize="9" FontWeight="Bold" Foreground="#555555"/>
            </Grid>


            <ItemsControl x:Name="InstalledVersionsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#0A0A0A" BorderBrush="#1A1A1A" BorderThickness="1"
                                CornerRadius="10" Padding="14,12" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>


                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8"
                                        Background="#111111" ClipToBounds="True" VerticalAlignment="Center">
                                    <Image Source="/LeitostrapV7;component/Resources/Roblox.png"
                                           Width="34" Height="34" Stretch="UniformToFill"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>


                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="Roblox" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock Text="{Binding}" FontSize="10" Foreground="#888888" VerticalAlignment="Center"/>
                                        <Border Style="{StaticResource SupportedBadge}" Margin="8,0,0,0">
                                            <TextBlock Text="Supported" FontSize="8" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>


                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource GreenBtn}" Margin="0,0,6,0"
                                            Tag="{Binding}" Click="VersionLaunch_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Play20" FontSize="10" Margin="0,0,4,0"/>
                                            <TextBlock Text="Launch" FontSize="9"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource RedBtn}"
                                            Tag="{Binding}" Click="VersionUninstall_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Delete20" FontSize="10" Margin="0,0,4,0"/>
                                            <TextBlock Text="Uninstall" FontSize="9"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>


            <TextBlock x:Name="NoVersionsText" Text="No Roblox versions installed"
                       FontSize="11" Foreground="#555555" HorizontalAlignment="Center"
                       Margin="0,20,0,0" Visibility="Collapsed"/>


        </StackPanel>
    </ScrollViewer>
</UserControl>
